# Copy to .env and fill in the secrets. Never commit .env.
# Everything except the keys below may be committed with its value.
# LLM_NAME, LLM_BASE_URL and LLM_API_KEY are the names required by the organisers
# (README, "Environment"). The older APERTUS_* names are still read as aliases.

# --- Secrets: leave empty here, fill in only in .env ---
LLM_API_KEY=              # Keera/CSCS gateway key (alias: APERTUS_API_KEY, KEERA_API_KEY)
HF_TOKEN=                 # Hugging Face token, only for downloading open-weights models

# --- Apertus gateway ---
LLM_BASE_URL=https://gateway.keera.ch/api/v1   # alias: APERTUS_BASE_URL
LLM_NAME=apertus-v1-5-8b                       # alias: APERTUS_MODEL; or apertus-v1-5-70b
#EMBEDDING_MODEL=intfloat/multilingual-e5-small   # optional: local open-weights embedding model (embed.py); this is the default

# --- Summaries knowledge base (SQLite) ---
SUMMARY_DB_PATH=data/processed/summaries.db        # relative to the project folder
