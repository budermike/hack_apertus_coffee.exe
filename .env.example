# Copy to .env and fill in the secrets. Never commit .env.
# Everything except the keys below may be committed with its value.
# LLM_NAME, LLM_BASE_URL and LLM_API_KEY are the names required by the organisers
# (README, "Environment"). The older APERTUS_* names are still read as aliases.
# Comments stand on their own lines: Docker Compose reads a comment that follows an
# empty value as the value.

# --- Secrets: leave empty here, fill in only in .env ---
# Keera/CSCS gateway key (alias: APERTUS_API_KEY, KEERA_API_KEY)
LLM_API_KEY=
# Hugging Face token, only for downloading open-weights models
HF_TOKEN=

# --- Apertus gateway ---
# Endpoint base URL (alias: APERTUS_BASE_URL)
LLM_BASE_URL=https://gateway.keera.ch/api/v1
# Model for the summaries (alias: APERTUS_MODEL); or apertus-v1-5-70b.
# The relevance scoring uses apertus-v1-5-70b unless `triage.cli relevance --model` says otherwise.
LLM_NAME=apertus-v1-5-8b
# Open-weights embeddings for the Vector-DB, run locally
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Summaries knowledge base (SQLite) ---
# relative to the project folder
SUMMARY_DB_PATH=data/processed/summaries.db
