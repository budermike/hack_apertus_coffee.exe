# Secrets and local config
.env
.env.*
!.env.example

# Model weights and checkpoints — do not commit these
*.bin
*.safetensors
*.gguf
*.ckpt
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info

# Node
node_modules/
dist/
build/

# OS and editor
.DS_Store
.idea/
.vscode/

#data
.data/
# Crawled court judgements stay local (keep only the empty folder in git)
data/raw/*
!data/raw/.gitkeep
# Local SQLite databases (summaries DB) stay out of git
*.db
*.db-wal
*.db-shm
