# Secrets and local config
.env
.env.*
!.env.example

# Model weights and checkpoints — do not commit these
*.bin
*.safetensors
*.gguf
*.ckpt
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info

# Node
node_modules/
dist/
build/

# OS and editor
.DS_Store
.idea/
.vscode/

# Derived triage data: embedding/Apertus cache
data/processed/triage/
#data
.data/
# Temporary / corrupt crawler files stay local; public BGer judgements in data/raw/ are tracked
data/raw/**/*.tmp
data/raw/**/*.corrupt-*
# Local SQLite databases (summaries DB) stay out of git
*.db
*.db-wal
*.db-shm
# Vector-DB: metadata.sqlite3 (~2 MB), embedder_meta.json and vectors/ (~79 MB) are tracked;
# large rebuildable local caches (fts.sqlite3, search_index.npz, SQLite WAL/SHM) stay local.
data/processed/vectordb/fts.sqlite3*
data/processed/vectordb/search_index.npz
data/processed/vectordb/*.sqlite3-wal
data/processed/vectordb/*.sqlite3-shm
data/processed/vectordb/*.lock
data/processed/vectordb/**/*.tmp*
